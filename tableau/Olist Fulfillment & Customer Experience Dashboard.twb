      <aliases enabled='yes' />
      <column caption='On-Time Rate' datatype='real' default-format='p0.00%' name='[Calculation_1422266529726464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([on_time_flag])' />
      </column>
      <column caption='Delivery Performance' datatype='string' name='[Calculation_1422266529918977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([delivery_variance_days]) THEN NULL&#10;ELSEIF [delivery_variance_days] &lt; 0 THEN &quot;Early&quot;&#10;ELSEIF [delivery_variance_days] = 0 THEN &quot;On time&quot;&#10;ELSEIF [delivery_variance_days] &lt;= 3 THEN &quot;1-3 days late&quot;&#10;ELSEIF [delivery_variance_days] &lt;= 7 THEN &quot;4-7 days late&quot;&#10;ELSEIF [delivery_variance_days] &lt;= 14 THEN &quot;8-14 days late&quot;&#10;ELSE &quot;15+ days late&quot;&#10;END' />
      </column>
      <column caption='Freight to Merchandise %' datatype='real' name='[Calculation_1422266530529282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([freight_value]) / SUM([merchandise_value])' />
      </column>
      <column caption='Fulfillment Evaluable Order' datatype='string' name='[Calculation_1422266542686211]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([on_time_flag]) THEN [order_id] END' />
      </column>
      <column caption='olist_order_analysis.tsv' datatype='table' name='[__tableau_internal_object_id__].[olist_order_analysis.tsv_E923EB20294646F88EFB480DFA7C56F6]' role='measure' type='quantitative' />
