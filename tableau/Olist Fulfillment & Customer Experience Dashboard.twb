  <worksheets>
    <worksheet name='Freight Burden by State'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Freight Cost Relative to Merchandise Value by State</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_order_analysis' name='federated.1rac9v31se0o4g17chb0j1scequ5' />
          </datasources>
          <datasource-dependencies datasource='federated.1rac9v31se0o4g17chb0j1scequ5'>
            <column caption='Freight to Merchandise %' datatype='real' name='[Calculation_1422266530529282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([freight_value]) / SUM([merchandise_value])' />
            </column>
            <column-instance column='[freight_value]' derivation='Avg' name='[avg:freight_value:qk]' pivot='key' type='quantitative' />
            <column-instance column='[merchandise_value]' derivation='Avg' name='[avg:merchandise_value:qk]' pivot='key' type='quantitative' />
