      <table>
        <view>
          <datasources>
            <datasource caption='olist_order_analysis' name='federated.1rac9v31se0o4g17chb0j1scequ5' />
          </datasources>
          <datasource-dependencies datasource='federated.1rac9v31se0o4g17chb0j1scequ5'>
            <column caption='On-Time Rate' datatype='real' default-format='p0.00%' name='[Calculation_1422266529726464]' role='measure' type='quantitative'>
