    <worksheet name='Review by Delivery Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Avenir'>Average Review Score by Delivery Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_order_analysis' name='federated.1rac9v31se0o4g17chb0j1scequ5' />
          </datasources>
          <datasource-dependencies datasource='federated.1rac9v31se0o4g17chb0j1scequ5'>
            <column caption='Delivery Performance' datatype='string' name='[Calculation_1422266529918977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivery_variance_days]) THEN NULL&#10;ELSEIF [delivery_variance_days] &lt; 0 THEN &quot;Early&quot;&#10;ELSEIF [delivery_variance_days] = 0 THEN &quot;On time&quot;&#10;ELSEIF [delivery_variance_days] &lt;= 3 THEN &quot;1-3 days late&quot;&#10;ELSEIF [delivery_variance_days] &lt;= 7 THEN &quot;4-7 days late&quot;&#10;ELSEIF [delivery_variance_days] &lt;= 14 THEN &quot;8-14 days late&quot;&#10;ELSE &quot;15+ days late&quot;&#10;END' />
            </column>
            <column-instance column='[review_score]' derivation='Avg' name='[avg:review_score:qk]' pivot='key' type='quantitative' />
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Delivery Variance Days' datatype='integer' name='[delivery_variance_days]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1422266529918977]' derivation='None' name='[none:Calculation_1422266529918977:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
            <column caption='Review Score' datatype='real' name='[review_score]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1rac9v31se0o4g17chb0j1scequ5].[none:Calculation_1422266529918977:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1422266529918977:nk]' member='&quot;1-3 days late&quot;' />
              <groupfilter function='member' level='[none:Calculation_1422266529918977:nk]' member='&quot;15+ days late&quot;' />
              <groupfilter function='member' level='[none:Calculation_1422266529918977:nk]' member='&quot;4-7 days late&quot;' />
              <groupfilter function='member' level='[none:Calculation_1422266529918977:nk]' member='&quot;8-14 days late&quot;' />
              <groupfilter function='member' level='[none:Calculation_1422266529918977:nk]' member='&quot;Early&quot;' />
              <groupfilter function='member' level='[none:Calculation_1422266529918977:nk]' member='&quot;On time&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.1rac9v31se0o4g17chb0j1scequ5].[none:Calculation_1422266529918977:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Early&quot;</bucket>
              <bucket>&quot;On time&quot;</bucket>
              <bucket>&quot;1-3 days late&quot;</bucket>
              <bucket>&quot;4-7 days late&quot;</bucket>
              <bucket>&quot;8-14 days late&quot;</bucket>
              <bucket>&quot;15+ days late&quot;</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.1rac9v31se0o4g17chb0j1scequ5].[none:Calculation_1422266529918977:nk]</column>
            <column>[federated.1rac9v31se0o4g17chb0j1scequ5].[none:customer_state:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[avg:review_score:qk]' field-type='quantitative' max='5.0' min='0.0' range-type='fixed' scope='cols' type='space' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[avg:review_score:qk]' value='n#,##0.00;-#,##0.00' />
          </style-rule>
          <style-rule element='header'>
            <format attr='height-header' value='21' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[none:Calculation_1422266529918977:nk]' value='Avenir' />
            <format attr='font-family' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[avg:review_score:qk]' value='Avenir' />
            <format attr='vertical-align' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[none:Calculation_1422266529918977:nk]' value='center' />
            <format attr='text-align' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[none:Calculation_1422266529918977:nk]' value='right' />
            <format attr='text-format' field='[federated.1rac9v31se0o4g17chb0j1scequ5].[avg:review_score:qk]' value='n#,##0.00;-#,##0.00' />
